{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Weather App: Debug",
            "request": "launch",
            "type": "dart",
            "program": "${workspaceFolder}/lib/main.dart",
            "cwd": "${workspaceFolder}",
            "flutterMode": "debug",
            "args": [
                "--dart-define-from-file=.env"
            ]
        },
        {
            "name": "Weather App: Release",
            "request": "launch",
            "type": "dart",
            "program": "${workspaceFolder}/lib/main.dart",
            "cwd": "${workspaceFolder}",
            "flutterMode": "release",
            "args": [
                "--dart-define-from-file=.env"
            ]
        },
        {
            "name": "Weather App: Profile",
            "request": "launch",
            "type": "dart",
            "program": "${workspaceFolder}/lib/main.dart",
            "cwd": "${workspaceFolder}",
            "flutterMode": "profile",
            "args": [
                "--dart-define-from-file=.env"
            ]
        }
    ]
}
